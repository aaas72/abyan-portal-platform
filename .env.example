# ════════════════════════════════════════════════════════════
# متغيرات البيئة لمنظومة أبين (Docker & Production Env)
# ════════════════════════════════════════════════════════════

# 1. إعدادات المنافذ (Ports)
FRONTEND_PORT=3000
BACKEND_PORT=4000

# 2. إعدادات الواجهة الخلفية (Backend - NestJS)
NODE_ENV=production
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/abyan?retryWrites=true&w=majority
JWT_SECRET=super_secret_jwt_key_please_change_in_production
INITIAL_ADMIN_PASSWORD=change_this_admin_password_123!
CORS_ORIGINS=http://localhost:3000

# 3. إعدادات التخزين السحابي للصور (Cloudinary - اختياري)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# 4. إعدادات الواجهة الأمامية (Frontend - Next.js)
NEXT_PUBLIC_API_URL=http://localhost:4000
